package mdm_views

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/open-uem/openuem-console/internal/security/access"
	"github.com/open-uem/openuem-console/internal/views/partials"
)

templ Navigation(info *partials.CommonInfo) {
	<details class="uk-card uk-card-default min-w-0 my-4">
		<summary class="cursor-pointer p-3 font-semibold" style="list-style-position: inside;">{ i18n.T(ctx,"management_navigation.title") }</summary>
		<nav aria-label={ i18n.T(ctx,"management_navigation.title") } class="flex flex-wrap gap-4 p-4">
			if info.Can(access.ReadSoftware) {
				<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/software/catalog")) }>{ i18n.T(ctx,"management_navigation.software") }</a>
			}
			<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/devices")) }>{ i18n.T(ctx,"management_navigation.devices") }</a>
			<a class="uk-button uk-button-default" href={templ.URL(partials.GetNavigationUrl(info,"/device-groups"))}>{i18n.T(ctx,"mdm.groups.title")}</a>
			if info.Principal.IsAdministrator() {
				<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/deploy")) }>{ i18n.T(ctx,"management_navigation.windows_deployment") }</a>
				<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/profiles")) }>{ i18n.T(ctx,"management_navigation.windows_profiles") }</a>
			}
			<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/ios/configurations")) }>{ i18n.T(ctx,"management_navigation.apple_profiles") }</a>
			<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/ios/setup")) }>{ i18n.T(ctx,"management_navigation.apple_enrollment") }</a>
			if info.Can(access.ManageCertificates) {
				<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/ios/ade")) }>{ i18n.T(ctx,"management_navigation.ade") }</a>
			}
			<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/desktop/enrollment")) }>{ i18n.T(ctx,"management_navigation.desktop_enrollment") }</a>
			if info.Can(access.ReadDevices) {
				<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, "/windows")) }>{ i18n.T(ctx,"management_navigation.windows_management") }</a>
			}
		</nav>
	</details>
}
