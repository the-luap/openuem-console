package mdm_views

templ DeviceIdentity(detail Detail) {
	<section class="uk-card uk-card-default min-w-0" aria-labelledby="device-identity-heading">
		<div class="uk-card-header"><h2 id="device-identity-heading" class="uk-card-title">Device identity</h2></div>
		<div class="uk-card-body grid gap-4 min-w-0">
			<p>{ "Current identity expires: "+detail.Device.CertificateExpiresAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
			if detail.Device.Status=="enrolled" {
				<p>Automatic renewal starts 30 days before expiry. The device must install the replacement enrollment profile and connect with its new identity to complete the change.</p>
				if detail.Device.IdentityRenewalError!="" {
					<div role="status" class="uk-alert uk-alert-warning">{ IdentityRenewalHelp(detail.Device.IdentityRenewalError) }</div>
				}
			}
			if len(detail.IdentityRenewals)==0 {
				<p class="uk-text-muted">No identity renewal has been scheduled.</p>
			} else {
				<p class="uk-text-muted">Latest renewal attempts, newest first.</p>
				for _,renewal:=range detail.IdentityRenewals {
					<article class="border rounded p-4 grid gap-3 min-w-0">
						<h3 class="font-medium">{ IdentityRenewalState(renewal) }</h3>
						<p>{ "Started: "+renewal.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
						if renewal.Status=="queued" {
							<p>{ "Device must request its certificate by: "+renewal.AuthorizationExpiresAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
						}
						if renewal.CertificateExpiresAt!=nil {
							<p>{ "New certificate expires: "+When(renewal.CertificateExpiresAt) }</p>
						}
						if renewal.ConfirmedAt!=nil {
							<p>{ "Device confirmed the new identity: "+When(renewal.ConfirmedAt) }</p>
						}
						if renewal.Error!="" {
							<p>{ IdentityRenewalHelp(renewal.Error) }</p>
						}
						<details class="min-w-0">
							<summary class="cursor-pointer">Certificate fingerprints and command reference</summary>
							<dl class="uk-description-list mt-3 min-w-0">
								<dt>Previous certificate SHA-256</dt><dd class="break-all font-mono">{ renewal.PreviousFingerprint }</dd>
								if renewal.Fingerprint!="" {
									<dt>New certificate SHA-256</dt><dd class="break-all font-mono">{ renewal.Fingerprint }</dd>
								}
								<dt>InstallProfile command</dt><dd class="break-all font-mono">{ renewal.CommandID }</dd>
							</dl>
						</details>
					</article>
				}
			}
		</div>
	</section>
}
