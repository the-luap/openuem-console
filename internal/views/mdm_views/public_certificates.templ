package mdm_views

import "github.com/open-uem/openuem-console/internal/views/partials"

templ PublicCertificatesEditor(info *partials.CommonInfo) {
	<details class="mt-6">
		<summary class="font-medium cursor-pointer">Create a public certificate profile</summary>
		<form method="post" enctype="multipart/form-data" action={ partials.GetNavigationUrl(info, "/ios/configurations") } class="grid gap-4 mt-4">
			@CSRF(info)
			<input type="hidden" name="editor" value="apple-certificates"/>
			<label>Name<input class="uk-input" name="name" maxlength="255" required placeholder="Company certificates"/></label>
			<label>Profile identifier<input class="uk-input" name="identifier" maxlength="255" required placeholder="com.company.certificates"/></label>
			<label>Scope<select class="uk-select" name="payload_scope" required><option value="System">Whole device</option><option value="User">Managed Mac user channel</option></select></label>
			<p>Whole-device profiles support iPhone and iPad from version 4.0 and Mac from macOS 10.7. User profiles apply only to a managed Mac user channel.</p>
			<label>Public certificates (PEM or DER, up to 256 KiB)<input class="uk-input" type="file" name="certificate" accept=".pem,.der,.cer,.crt" required/></label>
			<p>Import up to 16 certificates from one file. PEM bundles are split into separate certificate payloads; duplicates are removed. Private keys and identity archives are not accepted here.</p>
			<p>Installing a certificate authority can change which certificates the device trusts. Review the certificate source and fingerprint before assigning this profile.</p>
			<label><input class="uk-checkbox" type="checkbox" name="confirmed" value="yes" required/> I reviewed the certificates and intended trust configuration.</label>
			<p>Saving creates a versioned profile. Certificates outside their validity dates can be retained in the catalog but cannot be assigned. Profile installation confirms delivery; verify the intended certificate and trust behavior on the device.</p>
			<button class="uk-button uk-button-primary" type="submit">Create public certificate profile</button>
		</form>
	</details>
}
