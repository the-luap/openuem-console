package mdm_views

import (
 "fmt"
 "time"
 "github.com/labstack/echo/v4"
 "github.com/open-uem/openuem-console/internal/mdm/apple"
 "github.com/open-uem/openuem-console/internal/security/access"
 "github.com/open-uem/openuem-console/internal/views/layout"
 "github.com/open-uem/openuem-console/internal/views/partials"
)

templ WindowsSoftwareReconciliationReview(c echo.Context,info *partials.CommonInfo,review apple.WindowsSoftwareReconciliationReview,id string){
 @layout.Base("devices",info){
  <link rel="stylesheet" href="/assets/css/apple-device.css" type="text/css"/>
  @partials.Header(c,[]partials.Breadcrumb{{Title:"Approved software",Url:partials.GetNavigationUrl(info,"/software/catalog")},{Title:review.Version.Name,Url:partials.GetNavigationUrl(info,"/software/catalog/"+review.Version.ID)},{Title:"Review software check",Url:""}},info)
  <main id="device-management" class="grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
   <div><h1 class="text-2xl font-semibold">Review software check</h1>@Navigation(info)</div>
   <section class="uk-card uk-card-default">
    <div class="uk-card-header"><h2 class="uk-card-title">Read current software state</h2><p>This separate read-only check compares the device with its original software request.</p></div>
    <div class="uk-card-body">
     <dl class="uk-description-list"><dt>Target device</dt><dd>{review.TargetName} · {review.Request.AgentID}</dd><dt>Original site</dt><dd>{fmt.Sprint(review.Request.SiteID)}</dd><dt>Approved revision</dt><dd>{review.Version.Name} · {review.Version.Version}</dd><dt>Original operation</dt><dd>{WindowsSoftwareOperation(review.Request.Operation)}</dd><dt>Original execution evidence</dt><dd>{WindowsSoftwareDispatchState(*review.Original)}</dd><dt>Original execution request</dt><dd>{review.Original.ID}</dd><dt>Check deadline</dt><dd>{When(&review.ExpiresAt)}</dd></dl>
     if review.Request.Operation=="remove" {
      <p class="mt-4">The requested state is absence of the original product or machine registration.</p>
     } else {
      <p class="mt-4">The exact requested installed version is {review.Expectation.Detection.Version}.</p>
     }
     <p class="uk-alert mt-4">A later Windows restart and a definite software observation are required to release the device for another software operation. An unknown result keeps its reservation.</p>
     <p class="mt-4">This check does not run or repeat the installer. The original execution result remains in history. A compatible individual Windows agent must reconnect before the deadline; the check does not restart the device.</p>
     <form method="post" class="mt-4" action={partials.GetNavigationUrl(info,"/software/catalog/"+review.Version.ID+"/windows-requests/"+review.Request.ID+"/dispatch/reconcile")}>
      @CSRF(info)
      <input type="hidden" name="reconciliation_id" value={id}/><input type="hidden" name="review_hash" value={review.ReviewHash}/><input type="hidden" name="expires_at" value={review.ExpiresAt.UTC().Format(time.RFC3339)}/>
      <label><input class="uk-checkbox mr-2" type="checkbox" name="confirmed" value="yes" required/>I authorize this read-only check on this device before the displayed deadline.</label>
      <div class="flex flex-wrap gap-2 mt-4"><button class="uk-button uk-button-primary" type="submit">Check software state</button><a class="uk-button uk-button-default" href={partials.GetNavigationUrl(info,"/software/catalog/"+review.Version.ID+"/windows-requests/"+review.Request.ID+"/dispatch/reconciliations")}>Back to software checks</a></div>
     </form>
    </div>
   </section>
  </main>
 }
}

templ WindowsSoftwareReconciliations(c echo.Context,info *partials.CommonInfo,page apple.WindowsSoftwareReconciliationsPage){
 @layout.Base("devices",info){
  <link rel="stylesheet" href="/assets/css/apple-device.css" type="text/css"/>
  @partials.Header(c,[]partials.Breadcrumb{{Title:"Approved software",Url:partials.GetNavigationUrl(info,"/software/catalog")},{Title:page.Version.Name,Url:partials.GetNavigationUrl(info,"/software/catalog/"+page.Version.ID)},{Title:"Software checks",Url:""}},info)
  <main id="device-management" class="grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
   <div><h1 class="text-2xl font-semibold">Software checks</h1><p class="mt-2">{page.Version.Name} · {page.Version.Version} · {page.Request.AgentID}</p>@Navigation(info)</div>
   <section class="uk-card uk-card-default">
    <div class="uk-card-header"><h2 class="uk-card-title">Original execution evidence</h2></div>
    <div class="uk-card-body">
     <p role="status">{WindowsSoftwareDispatchState(*page.Original)}</p>
     <dl class="uk-description-list mt-4"><dt>Original operation</dt><dd>{WindowsSoftwareOperation(page.Request.Operation)}</dd><dt>Execution request</dt><dd>{page.Original.ID}</dd><dt>Original site</dt><dd>{fmt.Sprint(page.Request.SiteID)}</dd><dt>Dispatched</dt><dd>{When(&page.Original.CreatedAt)}</dd><dt>Delivered</dt><dd>{When(page.Original.DeliveredAt)}</dd><dt>Execution result recorded</dt><dd>{When(page.Original.CompletedAt)}</dd></dl>
     if page.Original.ReconciliationID!="" {
      <p class="uk-alert mt-4">A verified software check released this reservation at {When(page.Original.ReconciledAt)}. Another installation or removal requires a new explicit request.</p>
     } else if WindowsSoftwareCheckEligible(*page.Original) {
      <p class="mt-4">The device remains reserved while execution is uncertain or requires a restart. A separately confirmed check can establish its later software state.</p>
      if page.HasActive {
       <p role="status" class="mt-4">A software check is already queued or awaiting a result.</p>
      } else if info.Can(access.AssignSoftware) {
       <a class="uk-button uk-button-primary mt-4" href={partials.GetNavigationUrl(info,"/software/catalog/"+page.Version.ID+"/windows-requests/"+page.Request.ID+"/dispatch/reconcile")}>Review a read-only check</a>
      }
     }
     <a class="uk-button uk-button-default mt-4" href={partials.GetNavigationUrl(info,"/software/catalog/"+page.Version.ID+"/windows-requests")}>Back to request history</a>
    </div>
   </section>
   <section class="uk-card uk-card-default">
    <div class="uk-card-header"><h2 class="uk-card-title">Read-only check history</h2><p>Each observation remains separate from the original execution. A check never retries an installer or restarts the device.</p></div>
    <div class="uk-card-body">
     if len(page.Checks)==0 {
      <p>No software checks recorded for this execution request.</p>
     }
     for _,check:=range page.Checks {
      <article class="software-row">
       <h3 class="font-semibold">Software check · {check.ID}</h3><p role="status" class="mt-2">{WindowsSoftwareCheckState(check)}</p>
       <dl class="uk-description-list mt-4"><dt>Requested</dt><dd>{When(&check.CreatedAt)} · {check.Actor}</dd><dt>Deadline</dt><dd>{When(&check.ExpiresAt)}</dd><dt>Delivered</dt><dd>{When(check.DeliveredAt)}</dd><dt>Result recorded</dt><dd>{When(check.CompletedAt)}</dd></dl>
       if check.Outcome!=nil {
        <dl class="uk-description-list mt-4"><dt>Observed software state</dt><dd>{check.Outcome.Observation.State} {check.Outcome.Observation.Version}</dd></dl>
        if check.ReleasesReservation {
         <p class="mt-4">This verified observation released the original reservation.</p>
        } else {
         <p class="mt-4">This check did not release the original reservation.</p>
        }
       }
       if check.Status=="pending"&&info.Can(access.AssignSoftware) {
        <form method="post" class="mt-4" action={partials.GetNavigationUrl(info,"/software/catalog/"+page.Version.ID+"/windows-requests/"+page.Request.ID+"/dispatch/reconciliations/"+check.ID+"/cancel")}>
         @CSRF(info)
         <label><input class="uk-checkbox mr-2" type="checkbox" name="confirmed" value="yes" required/>Cancel this read-only check before delivery. The original reservation is unchanged.</label>
         <button class="uk-button uk-button-default mt-4" type="submit">Cancel queued check</button>
        </form>
       }
      </article>
     }
     if page.Next!="" {
      <a class="uk-button uk-button-default mt-4" href={partials.GetNavigationUrl(info,"/software/catalog/"+page.Version.ID+"/windows-requests/"+page.Request.ID+"/dispatch/reconciliations?before="+page.Next)}>Older software checks</a>
     }
    </div>
   </section>
  </main>
 }
}
