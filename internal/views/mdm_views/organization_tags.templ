package mdm_views

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/security/access"
	"github.com/open-uem/openuem-console/internal/views/layout"
	"github.com/open-uem/openuem-console/internal/views/partials"
	"net/url"
	"strconv"
)

func OrganizationTagsPath(info *partials.CommonInfo) string {
	return "/tenant/" + url.PathEscape(info.TenantID) + "/admin/tags"
}
func organizationTagPath(info *partials.CommonInfo, tag inventory.OrganizationTag) string {
	path := OrganizationTagsPath(info)
	if tag.ID > 0 {
		path += "/" + strconv.FormatInt(tag.ID, 10)
	}
	return path
}
func organizationTagsVisible(info *partials.CommonInfo) bool {
	id, err := strconv.Atoi(info.TenantID)
	return err == nil && id > 0 && info.Principal.Can(access.ReadDevices, access.Scope{TenantID: id})
}

templ OrganizationTagForm(info *partials.CommonInfo, tag inventory.OrganizationTag) {
	<form method="post" action={ organizationTagPath(info, tag) } class="grid gap-4" aria-label={ i18n.T(ctx, "organization_tags.edit") }>
		@CSRF(info)
		if tag.ID>0 {
			<input type="hidden" name="revision" value={ tag.Revision }/>
		}
		<label>{ i18n.T(ctx,"organization_tags.name") }<input class="uk-input" name="name" value={ tag.Name } maxlength="255" required/></label>
		<label>{ i18n.T(ctx,"organization_tags.description") }<input class="uk-input" name="description" value={ tag.Description } maxlength="2048"/></label>
		<label>{ i18n.T(ctx,"organization_tags.color") }<input type="color" name="color" value={ tag.Color } required/></label>
		<button type="submit" class="uk-button uk-button-primary">{ i18n.T(ctx,"organization_tags.save") }</button>
	</form>
}

templ OrganizationTagNavigation(info *partials.CommonInfo) {
	@Navigation(info)
	if info.Principal.IsAdministrator() {
		<a class="underline" href={ templ.URL("/tenant/"+url.PathEscape(info.TenantID)+"/admin/settings") }>{ i18n.T(ctx,"organization_tags.settings") }</a>
	}
}

templ OrganizationTags(c echo.Context, info *partials.CommonInfo, page *inventory.TagPage, filter inventory.ReportFilter, paging DevicePagination) {
	@layout.Base("devices", info) {
		<link rel="stylesheet" href="/assets/css/apple-device.css" type="text/css"/>
		@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "organization_tags.title"), Url: OrganizationTagsPath(info)}}, info)
		<main id="organization-tags" class="text-foreground grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
			<div>
				<h1 class="text-2xl font-semibold">{ i18n.T(ctx,"organization_tags.title") }</h1>
				<p class="uk-text-muted mt-2">{ i18n.T(ctx,"organization_tags.scope_help") }</p>
				@OrganizationTagNavigation(info)
			</div>
			<section class="uk-card uk-card-default">
				<div class="uk-card-body grid gap-4">
					<form method="get" action={ OrganizationTagsPath(info) } class="grid gap-4" aria-label={ i18n.T(ctx, "organization_tags.search") }>
						<label>{ i18n.T(ctx,"organization_tags.search") }<input class="uk-input" name="q" value={ filter.Search } maxlength="256"/></label>
						<button type="submit" class="uk-button uk-button-default">{ i18n.T(ctx,"organization_tags.search") }</button>
					</form>
					<h2 class="uk-card-title">{ i18n.T(ctx,"organization_tags.page_count",len(page.Tags)) }</h2>
					for _,tag:=range page.Tags {
						<article class="border-b pb-4" style="overflow-wrap:anywhere;">
							<h3 class="font-semibold"><a class="underline" href={ templ.URL(organizationTagPath(info, tag)) }>{ tag.Name }</a></h3>
							<p>{ tag.Description }</p>
							<p>{ i18n.T(ctx,"organization_tags.color") }: <code>{ tag.Color }</code></p>
						</article>
					}
					if len(page.Tags)==0 {
						<p>{ i18n.T(ctx,"organization_tags.empty") }</p>
					}
					@GroupPaging(paging, i18n.T(ctx, "organization_tags.pages"))
				</div>
			</section>
			if info.Can(access.ManageTags) {
				<section class="uk-card uk-card-default">
					<div class="uk-card-body grid gap-4">
						<h2 class="uk-card-title">{ i18n.T(ctx,"organization_tags.create") }</h2>
						@OrganizationTagForm(info, inventory.OrganizationTag{TagDefinition: inventory.TagDefinition{Color: "#64748b"}})
					</div>
				</section>
			}
		</main>
	}
}

templ OrganizationTag(c echo.Context, info *partials.CommonInfo, tag *inventory.OrganizationTag) {
	@layout.Base("devices", info) {
		<link rel="stylesheet" href="/assets/css/apple-device.css" type="text/css"/>
		@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "organization_tags.title"), Url: OrganizationTagsPath(info)}}, info)
		<main id="organization-tag" class="text-foreground grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
			<div style="overflow-wrap:anywhere;">
				<h1 class="text-2xl font-semibold">{ tag.Name }</h1>
				<p>{ tag.Description }</p>
				<p>{ i18n.T(ctx,"organization_tags.color") }: <code>{ tag.Color }</code></p>
				<p class="uk-text-muted mt-2">{ i18n.T(ctx,"organization_tags.scope_help") }</p>
				@OrganizationTagNavigation(info)
			</div>
			if info.Can(access.ManageTags) {
				<section class="uk-card uk-card-default">
					<div class="uk-card-body grid gap-4">
						<h2 class="uk-card-title">{ i18n.T(ctx,"organization_tags.edit") }</h2>
						@OrganizationTagForm(info, *tag)
					</div>
				</section>
				<section class="uk-card uk-card-default">
					<div class="uk-card-body grid gap-4">
						<h2 class="uk-card-title">{ i18n.T(ctx,"organization_tags.delete") }</h2>
						if tag.Used {
							<p role="status">{ i18n.T(ctx,"organization_tags.used") }</p>
						} else {
							<form method="post" action={ organizationTagPath(info, *tag) + "/delete" } class="grid gap-4" aria-label={ i18n.T(ctx, "organization_tags.delete") }>
								@CSRF(info)
								<input type="hidden" name="revision" value={ tag.Revision }/>
								<label><input type="checkbox" name="confirm" value="delete" required/> { i18n.T(ctx,"organization_tags.confirm_delete") }</label>
								<button type="submit" class="uk-button uk-button-danger">{ i18n.T(ctx,"organization_tags.delete") }</button>
							</form>
						}
					</div>
				</section>
			}
			<a class="underline" href={ templ.URL(OrganizationTagsPath(info)) }>{ i18n.T(ctx,"organization_tags.back") }</a>
		</main>
	}
}
