package desktop_views

import (
	"fmt"
	packageapi "github.com/open-uem/nats/netbirdinstall"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/security/access"
	"github.com/open-uem/openuem-console/internal/views/mdm_views"
	"github.com/open-uem/openuem-console/internal/views/partials"
	"net/url"
)

func NetbirdRemovalPath(info *partials.CommonInfo, device string) string {
	return partials.GetNavigationUrl(info, "/computers/"+url.PathEscape(device)+"/netbird/removals")
}
func netbirdRemovalLabel(state string) string {
	switch state {
	case "queued":
		return "Queued for removal"
	case "delivery_pending":
		return "Removal dispatched; awaiting its receipt"
	case "unconfirmed":
		return "Removal outcome is unconfirmed"
	case "stopped":
		return "Stopped before native removal"
	case "cancelled":
		return "Cancelled before native removal"
	case "completed":
		return "Package removal verified"
	case "released":
		return "Reviewed recovery confirmed; original result retained"
	default:
		return "Awaiting retained evidence"
	}
}
func netbirdRemovalStop(reason string) string {
	switch reason {
	case "expired":
		return "The request expired before native removal could be admitted."
	case "not_authorized":
		return "The original requester no longer has permission to assign software at this site."
	case "source_changed":
		return "The installed package, recipient or required agent readiness no longer matches the reviewed request."
	default:
		return "Automatic processing could not continue."
	}
}

templ netbirdRemovalDescriptor(p packageapi.Removal) {
	<dl class="netbird-details">
		<dt>Version</dt><dd>{ p.Version }</dd>
		<dt>Platform / architecture</dt><dd>{ p.Platform+" / "+p.Architecture }</dd>
		<dt>Package</dt><dd>{ p.PackageID+" ("+p.Format+")" }</dd>
		<dt>Installed-state fingerprint</dt><dd>{ p.StateDigest }</dd>
	</dl>
}

templ NetbirdRemovalReview(c echo.Context, info *partials.CommonInfo, v *inventory.NetbirdRemovalReview, requestID string) {
	@netbirdPage(c, info, v.Target.ID, "Review NetBird removal") {
		@netbirdTarget(v.Target)
		if v.Absent {
			<p role="status">The agent verified that the supported NetBird package, service and processes are absent. No removal request is needed.</p>
			<p>This current observation does not resolve an earlier uncertain request. Check its retained receipt and recovery evidence in removal history.</p>
		} else {
			@netbirdRemovalDescriptor(v.Descriptor)
			<div class="netbird-impact">
				<p>Confirmation queues removal of this exact local NetBird installation. The agent stops its verified service and processes, removes its owned package files and checks that removal completed.</p>
				<p>This interrupts NetBird connectivity and may make the device unreachable. Local settings, logs and the provider peer remain. The agent checks the reviewed installed state again before removal; uncertain delivery is not automatically repeated.</p>
			</div>
			<form method="post" action={ NetbirdRemovalPath(info, v.Target.ID) } hx-post={ NetbirdRemovalPath(info, v.Target.ID) } hx-target="#main" hx-swap="outerHTML" hx-sync="closest section:drop" hx-disabled-elt="#netbird-submit,#netbird-confirm" hx-indicator="#netbird-pending" class="netbird-confirm">
				@mdm_views.CSRF(info)
				<input type="hidden" name="request_id" value={ requestID }/>
				<input type="hidden" name="descriptor_digest" value={ v.DescriptorDigest }/>
				<input type="hidden" name="revision" value={ v.Revision }/>
				<label class="netbird-checkbox" for="netbird-confirm"><input id="netbird-confirm" type="checkbox" name="confirmed" value="yes" required/><span>I authorize removal of the reviewed NetBird installation and understand that this interrupts its connection.</span></label>
				<button class="uk-button uk-button-primary" id="netbird-submit" type="submit">Queue removal</button>
				<span class="htmx-indicator" id="netbird-pending" role="status">Queuing removal…</span>
			</form>
		}
		<a href={ NetbirdRemovalPath(info, v.Target.ID) }>Removal history</a>
	}
}

templ NetbirdRemovalReceipt(c echo.Context, info *partials.CommonInfo, v *inventory.NetbirdRemovalStatus, cancellationID string) {
	@netbirdPage(c, info, v.Request.DeviceID, "NetBird removal") {
		<p role="status" class="netbird-state">{ netbirdRemovalLabel(v.State()) }</p>
		if v.DispatchStop!=nil {
			<p>{ netbirdRemovalStop(v.DispatchStop.Reason) }</p>
		}
		if v.State()=="completed" {
			<p>Removal was verified at the recorded completion time. Device inventory and connection state may reflect an older report.</p>
		} else if v.State()=="released" {
			<p>Recovery evidence allows new NetBird operations. This does not confirm removal success or clean up retained local recovery data.</p>
		} else if v.Delivery!=nil {
			<p>Native delivery cannot be cancelled or repeated. Check the retained receipt, or review recovery if the outcome remains unclear.</p>

		}
		<dl class="netbird-details">
			<dt>Request ID</dt>
			<dd>{ v.Request.ID }</dd>
			<dt>Device ID</dt>
			<dd>{ v.Request.DeviceID }</dd>
			<dt>Organization / site</dt>
			<dd>{ fmt.Sprintf("%d / %d",v.Request.Scope.TenantID,v.Request.Scope.SiteID) }</dd>
			<dt>Requested by</dt>
			<dd>{ v.Request.Actor }</dd>
			<dt>Requested</dt>
			<dd>@mdm_views.Timestamp(&v.Request.RequestedAt)
</dd>
			<dt>Admission deadline</dt>
			<dd>@mdm_views.Timestamp(&v.Request.ExpiresAt)
</dd>
			if v.DispatchStop!=nil {
				<dt>Automatic processing stopped</dt>
				<dd>@mdm_views.Timestamp(&v.DispatchStop.RecordedAt)</dd>
			}
			if v.Delivery!=nil {
				<dt>Removal dispatched</dt>
				<dd>@mdm_views.Timestamp(&v.Delivery.IssuedAt)
</dd>
				<dt>Native execution deadline</dt>
				<dd>@mdm_views.Timestamp(&v.Delivery.ExpiresAt)
</dd>
				<dt>Original delivery outcome</dt>
				<dd>{ v.Delivery.OriginalOutcome }</dd>
				<dt>Original result retained</dt>
				<dd>@mdm_views.Timestamp(v.Delivery.RecordedAt)
</dd>
				if v.Delivery.ObservedAt!=nil {
					<dt>Latest receipt check</dt>
					<dd>@mdm_views.Timestamp(v.Delivery.ObservedAt)
</dd>
					<dt>Observed result</dt>
					<dd>{ v.Delivery.ObservedOutcome }</dd>
				}
			}
			if v.Request.CompletedAt!=nil {
				<dt>Removal verified</dt>
				<dd>@mdm_views.Timestamp(v.Request.CompletedAt)
</dd>
			}
			if v.Request.CancelledAt!=nil {
				<dt>Cancelled</dt>
				<dd>@mdm_views.Timestamp(v.Request.CancelledAt)
</dd>
				<dt>Cancelled by</dt>
				<dd>{ v.Request.CancelledBy }</dd>
			}
			if v.Request.ReleasedAt!=nil {
				<dt>Recovery confirmed</dt>
				<dd>@mdm_views.Timestamp(v.Request.ReleasedAt)
</dd>
				<dt>Confirmed by</dt>
				<dd>{ v.Request.ReleasedBy }</dd>
			}
		</dl>
		<details><summary>Reviewed installed package</summary>@netbirdRemovalDescriptor(v.Request.Descriptor)
</details>
		if v.Resolution!=nil {
			@netbirdRemovalResolutionSummary(v.Resolution)
		}
		if v.Request.CancelledAt==nil && v.Request.CompletedAt==nil && v.Request.ReleasedAt==nil && info.Principal.Can(access.AssignSoftware,v.Request.Scope) {
			if v.Delivery==nil {
				<p>Cancellation prevents native removal from being admitted for this request.</p>
				<form method="post" action={ NetbirdRemovalPath(info, v.Request.DeviceID) + "/" + v.Request.ID + "/cancel" } class="netbird-confirm">
					@mdm_views.CSRF(info)
					<input type="hidden" name="revision" value={ v.Request.Revision }/>
					<input type="hidden" name="cancellation_id" value={ cancellationID }/>
					<label class="netbird-checkbox" for="netbird-cancel"><input id="netbird-cancel" type="checkbox" name="confirmed" value="yes" required/><span>Cancel this request if native removal has not been admitted.</span></label>
					<button class="uk-button uk-button-default" type="submit">Cancel removal request</button>
				</form>
			} else {
				@netbirdRemovalEvidenceForm(info, v.Request, "observe", "", "Check retained receipt")
				<a class="uk-button uk-button-default" href={ NetbirdRemovalPath(info, v.Request.DeviceID) + "/" + v.Request.ID + "/resolution" }>Review removal recovery</a>
				if v.Resolution!=nil {
					@netbirdRemovalEvidenceForm(info, v.Request, "resolution/reconcile", v.Resolution.ID, "Reconcile recovery evidence")
				}
			}
		}
 if v.CanReviewRecovery && info.Principal.Can(access.AssignSoftware,v.Request.Scope) {
  <a class="uk-button uk-button-primary" href={NetbirdRemovalRecoveryPath(info,v.Request.DeviceID)+"/review?original_id="+url.QueryEscape(v.Request.ID)}>Review continuation of interrupted removal</a>
 }
		<div class="netbird-actions">
			<a class="uk-button uk-button-default" href={ NetbirdRemovalPath(info, v.Request.DeviceID) + "/" + v.Request.ID }>Reload status</a>
			<a class="uk-button uk-button-default" href={ NetbirdRemovalPath(info, v.Request.DeviceID) }>Removal history</a>
 <a class="uk-button uk-button-default" href={NetbirdRemovalRecoveryPath(info,v.Request.DeviceID)}>Continuation history</a>
		</div>
	}
}

templ netbirdRemovalEvidenceForm(info *partials.CommonInfo, r *inventory.NetbirdRemoval, suffix, resolutionID, label string) {
	<form method="post" action={ NetbirdRemovalPath(info, r.DeviceID) + "/" + r.ID + "/" + suffix } class="netbird-confirm">
		@mdm_views.CSRF(info)
		<input type="hidden" name="confirmed" value="yes"/>
		<input type="hidden" name="revision" value={ r.Revision }/>
		if resolutionID!="" {
			<input type="hidden" name="resolution_id" value={ resolutionID }/>
		}
		<button class="uk-button uk-button-default" type="submit">{ label }</button>
	</form>
}

templ netbirdRemovalResolutionSummary(d *inventory.NetbirdRemovalResolution) {
	<dl class="netbird-details">
		<dt>Recovery ID</dt>
		<dd>{ d.ID }</dd>
		<dt>Recovery requested by</dt>
		<dd>{ d.Actor }</dd>
		<dt>Recovery requested</dt>
		<dd>@mdm_views.Timestamp(&d.CreatedAt)
</dd>
		if d.LastAttempt!=nil {
			<dt>Latest recovery attempt</dt>
			<dd>{ fmt.Sprintf("%d: %s",d.LastAttempt.Sequence,d.LastAttempt.Kind) }</dd>
			<dt>Attempted by</dt>
			<dd>{ d.LastAttempt.Actor }</dd>
			<dt>Attempted</dt>
			<dd>@mdm_views.Timestamp(&d.LastAttempt.CreatedAt)
</dd>
			<dt>Retained outcome</dt>
			<dd>{ d.LastAttempt.Outcome }</dd>
		}
	</dl>
}

templ NetbirdRemovalResolution(c echo.Context, info *partials.CommonInfo, status *inventory.NetbirdRemovalStatus, v *inventory.NetbirdRemovalResolutionReview) {
	@netbirdPage(c, info, status.Request.DeviceID, "Review removal recovery") {
		<dl class="netbird-details">
			<dt>Original request</dt>
			<dd>{ status.Request.ID }</dd>
			<dt>Device ID</dt>
			<dd>{ status.Request.DeviceID }</dd>
			<dt>Agent evidence</dt>
			<dd>{ netbirdRemovalRecoveryState(v.Outcome) }</dd>
			if v.ExpiresAt!=nil {
				<dt>Review expires</dt>
				<dd>@mdm_views.Timestamp(v.ExpiresAt)
</dd>
			}
		</dl>
		if v.Resolution!=nil {
			@netbirdRemovalResolutionSummary(v.Resolution)
		}
		if v.Revision!="" && (v.Kind=="withdraw" || v.Kind=="release") {
			if v.Kind=="withdraw" {
				<p>Confirmation permanently blocks any later delivery of this original removal request if the agent has not attempted it. New NetBird operations become available only after matching withdrawal proof is retained.</p>
			} else {
				<p>The agent permits explicit release of this unconfirmed removal entry. Release allows further NetBird operations after matching proof; it does not confirm removal success, stop an independent process or clean up retained local recovery data.</p>
			}
			if v.Resolution!=nil {
				<p>This is an additional explicitly reviewed recovery attempt using the same permanent recovery ID. It does not resend the removal command.</p>
			}
			<form method="post" action={ NetbirdRemovalPath(info, status.Request.DeviceID) + "/" + status.Request.ID + "/resolution" } hx-post={ NetbirdRemovalPath(info, status.Request.DeviceID) + "/" + status.Request.ID + "/resolution" } hx-target="#main" hx-swap="outerHTML" hx-sync="closest section:drop" hx-disabled-elt="#netbird-submit,#netbird-confirm" hx-indicator="#netbird-pending" class="netbird-confirm">
				@mdm_views.CSRF(info)
				<input type="hidden" name="revision" value={ status.Request.Revision }/>
				<input type="hidden" name="resolution_id" value={ v.ResolutionID }/>
				<input type="hidden" name="review_revision" value={ v.Revision }/>
				<label class="netbird-checkbox" for="netbird-confirm"><input id="netbird-confirm" type="checkbox" name="confirmed" value="yes" required/><span>I reviewed this evidence and authorize the described recovery action and further NetBird operations after matching proof.</span></label>
				<button class="uk-button uk-button-primary" id="netbird-submit" type="submit">{ map[string]string{"withdraw":"Confirm permanent withdrawal","release":"Confirm reviewed release"}[v.Kind] }</button>
				<span class="htmx-indicator" id="netbird-pending" role="status">Recording recovery attempt…</span>
			</form>
			<p>If this review expires or the evidence changes, review again before confirming.</p>
		} else if v.Outcome!="completed" && v.Outcome!="released" {
			<p role="status">No new recovery action is currently eligible. Missing or uncertain evidence keeps further NetBird operations blocked.</p>
		}
		if v.Resolution!=nil && v.Outcome!="completed" && v.Outcome!="released" {
			@netbirdRemovalEvidenceForm(info, status.Request, "resolution/reconcile", v.Resolution.ID, "Reconcile recovery evidence")
		}
		<div class="netbird-actions">
			<a class="uk-button uk-button-default" href={ NetbirdRemovalPath(info, status.Request.DeviceID) + "/" + status.Request.ID + "/resolution" }>Review again</a>
			<a class="uk-button uk-button-default" href={ NetbirdRemovalPath(info, status.Request.DeviceID) + "/" + status.Request.ID }>Removal receipt</a>
		</div>
	}
}

func netbirdRemovalRecoveryState(state string) string {
	switch state {
	case "not-received":
		return "No attempt retained; permanent withdrawal is available"
	case "unconfirmed":
		return "The exact removal entry is unconfirmed and eligible for release"
	case "awaiting-confirmation":
		return "The owned recovery result is visible and awaits reconciliation"
	case "completed":
		return "A matching completed removal receipt is retained"
	case "released":
		return "Recovery is already confirmed"
	case "conflict":
		return "The observed recovery identity conflicts with this request"
	case "waiting":
		return "The current journal does not permit recovery"
	default:
		return "Matching recovery evidence is currently unavailable"
	}
}

templ NetbirdRemovalHistory(c echo.Context, info *partials.CommonInfo, scope access.Scope, device string, page *inventory.NetbirdRemovalHistory) {
	@netbirdPage(c, info, device, "NetBird removal history") {
		<p>Retained requests and outcomes for this device at the selected organization and site. Opening history does not contact the agent.</p>
		if len(page.Requests)==0 {
			<p role="status">No removal requests are recorded here.</p>
		} else {
			<ul class="netbird-history">
				for _,v:=range page.Requests {
					<li>
						<a href={ NetbirdRemovalPath(info, device) + "/" + v.Request.ID } class="netbird-id">{ "NetBird "+v.Request.Descriptor.Version+" · "+v.Request.ID }</a>
						<span>{ netbirdRemovalLabel(v.State()) }</span>
						<span>{ "Requested by "+v.Request.Actor }</span>
						@mdm_views.Timestamp(&v.Request.RequestedAt)
					</li>
				}
			</ul>
		}
		<div class="netbird-actions">
			if page.Next!="" {
				<a class="uk-button uk-button-default" href={ NetbirdRemovalPath(info, device) + "?before=" + url.QueryEscape(page.Next) }>Older requests</a>
			}
			if info.Principal.Can(access.AssignSoftware,scope) {
				<a class="uk-button uk-button-primary" href={ NetbirdRemovalPath(info, device) + "/review" }>Review removal</a>
			}
		</div>
	}
}
