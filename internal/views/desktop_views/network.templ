package desktop_views

import (
	"github.com/labstack/echo/v4"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/views/layout"
	"github.com/open-uem/openuem-console/internal/views/mdm_views"
	"github.com/open-uem/openuem-console/internal/views/partials"
)

func reportedNetworkFlag(value *bool) string {
	if value == nil {
		return "Not reported"
	}
	if *value {
		return "Yes"
	}
	return "No"
}

templ Network(c echo.Context, info *partials.CommonInfo, page *inventory.NetworkPage, filter inventory.NetworkFilter) {
	@layout.Base("devices", info) {
		@partials.Header(c, []partials.Breadcrumb{{Title: "Devices", Url: partials.GetNavigationUrl(info, "/devices")}, {Title: page.DeviceName}}, info)
		<main class="text-foreground grid min-w-0 flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8" style="grid-template-columns: minmax(0, 1fr);">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold break-words">{ page.DeviceName }</h1>
				<p class="uk-text-muted mt-2">Reported network</p>
				@mdm_views.Navigation(info)
				@InventoryNavigation(info, page.DeviceID, "network")
			</div>
			<section class="uk-card uk-card-default min-w-0">
				<div class="uk-card-header"><h2 class="uk-card-title">Network inventory</h2></div>
				<div class="uk-card-body min-w-0">
					<p class="break-words">{ page.Organization } / { page.Site }</p>
					<p class="uk-text-muted mt-2">Last agent report:{ " " }
						@mdm_views.Timestamp(page.LastContact)
					</p>
					<p class="uk-text-muted mt-2">These are stored agent reports. They do not verify current connectivity or configuration. A new report can change entries while you browse.</p>
					<form method="get" action={ networkURL(info, page.DeviceID, "", 0) } class="mt-4">
						<label for="network-search">Search by adapter name or address</label>
						<input class="uk-input mt-2" id="network-search" name="q" value={ filter.Search } maxlength="256" type="search"/>
						<div class="flex flex-wrap gap-2 mt-2">
							<button type="submit" class="uk-button uk-button-primary">Search</button>
							<a class="uk-button uk-button-default" href={ networkURL(info, page.DeviceID, "", 0) }>Clear search</a>
						</div>
					</form>
					if len(page.Entries) == 0 {
						<p role="status" class="mt-4">No reported network adapters on this page. Try the first page or change the search; an empty report does not prove that the device has no network adapters.</p>
					} else {
						<p class="uk-text-muted mt-4">Up to 25 adapters in report order</p>
						<div aria-label="Reported adapter entries" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 1rem;">
							for _, entry := range page.Entries {
								<article class="border-t border-border mt-4 pt-4 min-w-0">
									<h3 class="font-semibold break-all">{ mdm_views.Show(entry.Name) }</h3>
									<dl class="uk-description-list break-all">
										<dt>MAC address</dt>
										<dd>{ mdm_views.Show(entry.MAC) }</dd>
										<dt>IP addresses</dt>
										<dd>{ mdm_views.Show(entry.Addresses) }</dd>
										<dt>Subnet</dt>
										<dd>{ mdm_views.Show(entry.Subnet) }</dd>
										<dt>Default gateway</dt>
										<dd>{ mdm_views.Show(entry.Gateway) }</dd>
										<dt>DNS servers</dt>
										<dd>{ mdm_views.Show(entry.DNS) }</dd>
										<dt>DNS domain</dt>
										<dd>{ mdm_views.Show(entry.Domain) }</dd>
										<dt>DHCP enabled</dt>
										<dd>{ reportedNetworkFlag(entry.DHCPEnabled) }</dd>
										<dt>Link speed</dt>
										<dd>{ mdm_views.Show(entry.Speed) }</dd>
										<dt>Virtual adapter</dt>
										<dd>{ reportedNetworkFlag(entry.Virtual) }</dd>
									</dl>
								</article>
							}
						</div>
					}
					<nav aria-label="Network pages" class="flex flex-wrap gap-2 mt-4">
						if filter.After > 0 {
							<a class="uk-button uk-button-default" href={ networkURL(info, page.DeviceID, filter.Search, 0) }>First page</a>
						}
						if page.Next > 0 {
							<a class="uk-button uk-button-default" rel="next" href={ networkURL(info, page.DeviceID, filter.Search, page.Next) }>Next page</a>
						}
					</nav>
				</div>
			</section>
		</main>
	}
}
