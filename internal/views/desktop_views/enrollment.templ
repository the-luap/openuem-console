package desktop_views

import (
	"fmt"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/openuem-console/internal/security/access"
	"github.com/open-uem/openuem-console/internal/views/layout"
	"github.com/open-uem/openuem-console/internal/views/mdm_views"
	"github.com/open-uem/openuem-console/internal/views/partials"
)

templ Enrollment(c echo.Context, info *partials.CommonInfo, data EnrollmentData) {
	@layout.Base("devices", info) {
		@partials.Header(c, []partials.Breadcrumb{{Title: "Desktop enrollment", Url: partials.GetNavigationUrl(info, "/desktop/enrollment")}}, info)
		<main class="text-foreground grid min-w-0 flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
			<div>
				<h1 class="text-2xl font-semibold">Desktop enrollment</h1>
				<p class="uk-text-muted mt-2">Individual Windows and Mac identities for this organization and site.</p>
				@mdm_views.Navigation(info)
			</div>
			if data.SetupError!="" {
				<div role="alert" class="uk-alert uk-alert-warning">{ data.SetupError }</div>
			}
			<section class="uk-card uk-card-default min-w-0">
				<div class="uk-card-header"><h2 class="uk-card-title">Organization identity</h2><p>Each enrolled computer generates its own private keys. The organization's certificate authority signs its public identity.</p></div>
				<div class="uk-card-body min-w-0">
					if data.Authority!=nil {
						<dl class="uk-description-list"><dt>Organization</dt><dd class="break-words">{ data.Authority.Organization }</dd><dt>Public enrollment address</dt><dd class="break-all">{ data.Authority.PublicOrigin }</dd><dt>Certificate authority expires</dt><dd>{ data.Authority.ExpiresAt.UTC().Format("2006-01-02 15:04 UTC") }</dd></dl>
					} else if data.SetupError=="" {
						if data.PublicOrigin=="" {
							<p role="status">A server administrator must configure the public enrollment address before setup.</p>
						} else if info.Can(access.ManageCertificates) {
							<form method="post" action={ partials.GetNavigationUrl(info, "/desktop/setup") } enctype="multipart/form-data" class="grid min-w-0 gap-4">
								@mdm_views.CSRF(info)
								<label>Organization name<input name="organization" class="uk-input" value={ data.Organization } maxlength="255" required/></label>
								<p class="break-all">Enrollment address: { data.PublicOrigin }</p>
								<fieldset class="grid gap-3"><legend class="font-semibold">Certificate authority</legend><label><input type="radio" name="authority_source" value="automatic" checked/> Create an organization authority automatically</label><label><input type="radio" name="authority_source" value="enterprise"/> Import an enterprise authority</label></fieldset>
								<details><summary class="cursor-pointer">Enterprise authority files</summary><div class="grid gap-3 mt-3"><label>CA certificate (PEM)<input class="uk-input" type="file" name="authority_certificate" accept=".pem,.crt,.cer"/></label><label>CA private key (PEM)<input class="uk-input" type="file" name="authority_key" accept=".pem,.key"/></label><p class="uk-text-muted">Use these files only when importing an enterprise authority. The private key is encrypted in the database and is never included in an enrollment download.</p></div></details>
								<button type="submit" class="uk-button uk-button-primary">Set up organization identity</button>
							</form>
						} else {
							<p>An organization administrator must set up the certificate authority.</p>
						}
					}
				</div>
			</section>
			<section class="uk-card uk-card-default min-w-0"><div class="uk-card-header"><h2 class="uk-card-title">Installation links</h2></div><div class="uk-card-body"><p>Signed agent packages must be configured before new installation links are available.</p><p class="uk-text-muted mt-2">Creating an identity does not confirm that an agent has been installed or has reported inventory.</p></div></section>
			<section class="uk-card uk-card-default min-w-0">
				<div class="uk-card-header"><h2 class="uk-card-title">Enrollment invitations</h2><p>Invitation links are shown only when created. Revoking a link stops new enrollment; existing device identities remain managed.</p></div>
				<div class="uk-card-body min-w-0">
					<div class="overflow-x-auto" tabindex="0" role="region" aria-label="Enrollment invitations table">
						<table class="uk-table uk-table-divider min-w-[48rem]">
							<caption class="sr-only">Enrollment invitations in the selected organization and site</caption>
							<thead><tr><th scope="col">Invitation</th><th scope="col">Target</th><th scope="col">Uses</th><th scope="col">Expires</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
							<tbody>
								for _,row:=range data.Invitations.Rows {
									<tr>
										<td class="break-all">{ row.ID }</td>
										<td>{ row.Platform } / { row.Architecture }</td>
										<td>{ fmt.Sprintf("%d / %d",row.Uses,row.MaxUses) }</td>
										<td class="whitespace-nowrap">{ row.ExpiresAt.UTC().Format("2006-01-02 15:04 UTC") }</td>
										<td>{ invitationState(row) }</td>
										<td>
											if row.RevokedAt==nil && info.Can(access.EnrollDevices) {
												<details>
													<summary class="cursor-pointer">Revoke invitation</summary>
													<p class="my-3">Stop further use of this invitation?</p>
													<form method="post" action={ partials.GetNavigationUrl(info, "/desktop/invitations/"+row.ID+"/revoke") }>
														@mdm_views.CSRF(info)
														<input type="hidden" name="confirm_revoke" value="yes"/><button class="uk-button uk-button-danger" type="submit">Confirm revocation</button>
													</form>
												</details>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if len(data.Invitations.Rows)==0 {
						<p class="uk-text-muted my-4">No invitations in this view.</p>
					}
					if data.Invitations.Next!="" {
						<a class="uk-button uk-button-default" href={ templ.URL(nextPage(partials.GetNavigationUrl(info, "/desktop/enrollment"), "invitations_before", data.Invitations.Next)) }>Older invitations</a>
					}
				</div>
			</section>
			<section class="uk-card uk-card-default min-w-0">
				<div class="uk-card-header"><h2 class="uk-card-title">Individual identities</h2></div>
				<div class="uk-card-body min-w-0">
					<div class="overflow-x-auto" tabindex="0" role="region" aria-label="Individual identities table">
						<table class="uk-table uk-table-divider min-w-[48rem]">
							<caption class="sr-only">Individual identities in the selected organization and site</caption>
							<thead><tr><th scope="col">Device</th><th scope="col">Target</th><th scope="col">Issued</th><th scope="col">Certificate expires</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
							<tbody>
								for _,row:=range data.Identities.Rows {
									<tr>
										<td><span class="font-medium break-words">{ row.DisplayName }</span><br/><span class="uk-text-muted break-all">{ row.ID }</span></td>
										<td>{ row.Platform } / { row.Architecture }</td>
										<td class="whitespace-nowrap">{ row.EnrolledAt.UTC().Format("2006-01-02 15:04 UTC") }</td>
										<td class="whitespace-nowrap">{ row.CertificateExpiresAt.UTC().Format("2006-01-02 15:04 UTC") }</td>
										<td>{ identityState(row) }</td>
										<td>
											if row.RevokedAt==nil && info.Can(access.RevokeDevices) {
												<details>
													<summary class="cursor-pointer">Revoke identity</summary>
													<p class="my-3">Revoke management access for <strong>{ row.DisplayName }</strong>? Its broker connection and command channel will be removed. Enroll the computer again to restore management.</p>
													<form method="post" action={ partials.GetNavigationUrl(info, "/desktop/identities/"+row.ID+"/revoke") }>
														@mdm_views.CSRF(info)
														<input type="hidden" name="confirm_revoke" value="yes"/><button class="uk-button uk-button-danger" type="submit">Confirm revocation</button>
													</form>
												</details>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if len(data.Identities.Rows)==0 {
						<p class="uk-text-muted my-4">No individual desktop identities in this view.</p>
					}
					if data.Identities.Next!="" {
						<a class="uk-button uk-button-default" href={ templ.URL(nextPage(partials.GetNavigationUrl(info, "/desktop/enrollment"), "identities_before", data.Identities.Next)) }>Older identities</a>
					}
				</div>
			</section>
		</main>
	}
}
