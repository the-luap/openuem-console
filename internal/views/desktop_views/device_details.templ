package desktop_views

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/ent/agent"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/views/layout"
	"github.com/open-uem/openuem-console/internal/views/mdm_views"
	"github.com/open-uem/openuem-console/internal/views/partials"
	"net/url"
)

func detailsName(data *inventory.DeviceDetails) string {
	if data.Values.Nickname != "" {
		return data.Values.Nickname
	}
	if data.Hostname != "" {
		return data.Hostname
	}
	return data.DeviceID
}

templ Details(c echo.Context, info *partials.CommonInfo, data *inventory.DeviceDetails, draft inventory.DeviceDetailValues, message string) {
	@layout.Base("devices", info) {
		@partials.Header(c, []partials.Breadcrumb{{Title: "Devices", Url: partials.GetNavigationUrl(info, "/devices")}, {Title: detailsName(data)}}, info)
		<main class="text-foreground grid min-w-0 flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold break-words">{ detailsName(data) }</h1>
				<p>{ i18n.T(ctx,"device_details.title") }</p>
				<p class="break-all">{ i18n.T(ctx,"device_details.device_id") } { data.DeviceID }</p>
				<p class="break-words">{ i18n.T(ctx,"device_details.hostname") } { data.Hostname }</p>
				@mdm_views.Navigation(info)
				@InventoryNavigation(info, data.DeviceID, "details")
			</div>
			if message!="" {
				<div role="alert" class="uk-alert uk-alert-warning">{ message }</div>
			}
			<section class="uk-card uk-card-default min-w-0">
				<div class="uk-card-header"><h2 class="uk-card-title">{ i18n.T(ctx,"device_details.edit") }</h2></div>
				<div class="uk-card-body min-w-0">
					<form method="post" action={ partials.GetNavigationUrl(info, "/computers/"+url.PathEscape(data.DeviceID)+"/details") } hx-boost="false" class="grid min-w-0 gap-4">
						@mdm_views.CSRF(info)
						<input type="hidden" name="revision" value={ data.Revision }/>
						<div class="min-w-0">
							<label for="device-nickname">{ i18n.T(ctx,"device_details.nickname") }</label>
							<input id="device-nickname" class="uk-input w-full" name="nickname" type="text" maxlength="255" value={ draft.Nickname } aria-describedby="device-nickname-help"/>
							<p id="device-nickname-help" class="uk-text-muted mt-2">{ i18n.T(ctx,"device_details.nickname_help") }</p>
						</div>
						<div class="min-w-0">
							<label for="device-description">{ i18n.T(ctx,"device_details.description") }</label>
							<textarea id="device-description" name="description" rows="6" maxlength="4096" class="uk-textarea w-full" aria-describedby="device-description-help">{ draft.Description }</textarea>
							<p id="device-description-help" class="uk-text-muted mt-2">{ i18n.T(ctx,"device_details.description_help") }</p>
						</div>
						<div class="min-w-0">
							<label for="device-type">{ i18n.T(ctx,"device_details.endpoint_type") }</label>
							<select id="device-type" name="endpoint_type" class="uk-select w-full" required>
								for _,kind:=range []agent.EndpointType{agent.EndpointTypeDesktopPC,agent.EndpointTypeLaptop,agent.EndpointTypeServer,agent.EndpointTypeTablet,agent.EndpointTypeVM,agent.EndpointTypeAllInOne,agent.EndpointTypeOther} {
									<option value={ string(kind) } selected?={ draft.EndpointType==string(kind) }>{ i18n.T(ctx,string(kind)) }</option>
								}
							</select>
						</div>
						<p>{ i18n.T(ctx,"device_details.impact") }</p>
						<div><button type="submit" class="uk-button uk-button-primary">{ i18n.T(ctx,"device_details.save") }</button></div>
					</form>
				</div>
			</section>
			if message!="" {
				<section class="uk-card uk-card-default min-w-0">
					<div class="uk-card-header"><h2 class="uk-card-title">{ i18n.T(ctx,"device_details.saved") }</h2></div>
					<div class="uk-card-body min-w-0 break-words">
						<dl class="uk-description-list">
							<dt>{ i18n.T(ctx,"device_details.nickname") }</dt>
							<dd>{ data.Values.Nickname }</dd>
							<dt>{ i18n.T(ctx,"device_details.description") }</dt>
							<dd class="whitespace-pre-wrap">{ data.Values.Description }</dd>
							<dt>{ i18n.T(ctx,"device_details.endpoint_type") }</dt>
							<dd>{ i18n.T(ctx,data.Values.EndpointType) }</dd>
						</dl>
					</div>
				</section>
			}
		</main>
	}
}
