package tasks_views

import (
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/ent/task"
	"github.com/open-uem/nats"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/views/partials"
)

templ EditTask(c echo.Context, review *inventory.TaskEditReview, groups []nats.NetBirdGroups, commonInfo *partials.CommonInfo) {
	@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "Tasks")}}, commonInfo)
	<main hx-history="false" class="grid min-w-0 flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
		<div id="error" class="hidden"></div>
		@TaskEditingForm(review, groups, commonInfo)
	</main>
}

templ TaskEditingForm(review *inventory.TaskEditReview, groups []nats.NetBirdGroups, commonInfo *partials.CommonInfo) {
	<link rel="stylesheet" href="/assets/css/task-editing.css"/>
 {{ t := review.Task }}
	{{ profileID := review.ProfileID }}
	<div class="min-w-0 uk-card uk-card-default">
		<div class="uk-card-header">
			<div class="flex justify-between items-center">
				<div class="flex flex-col my-4 mx-1">
					<h3 class="uk-card-title">{ i18n.T(ctx, "tasks.edit.title") }</h3>
					<p class="mt-2">{ i18n.T(ctx,"task_editing.identity",t.ID,profileID,t.Version) }</p>
					<p class="uk-margin-small-top uk-text-small">
						{ i18n.T(ctx, "task_editing.description") }
					</p>
				</div>
			</div>
		</div>
		<div class="uk-card-body">
			<form
				id="task-edit-form"
				class="flex flex-col gap-4 my-6"
				hx-disinherit="hx-include"
				hx-disabled-elt="#task-edit-controls"
				hx-post={ string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/tasks/%d", t.ID)))) }
				hx-target="this"
				hx-swap="none"
				hx-push-url="false"
			>
				<fieldset id="task-edit-controls" class="min-w-0">
					<input type="hidden" name="profile" value={ fmt.Sprint(profileID) }/>
					<input type="hidden" name="task-version" value={ fmt.Sprint(t.Version) }/>
					<input type="hidden" name="task-agent-type" value={ t.AgentType.String() }/>
					<div class="flex flex-col gap-4 w-full">
						<div>
							<label class="uk-form-label" for="task-description">
								{ i18n.T(ctx, "tasks.new.name") }
							</label>
							<div class="uk-form-controls">
								<textarea
									id="task-description"
									name="task-description"
									class="uk-textarea"
									required
									maxlength="2048"
									rows="2"
									placeholder={ i18n.T(ctx, "tasks.new.text") }
									aria-label="Task description"
									autocomplete="off"
									autocorrect="off"
									autocapitalize="off"
									spellcheck="false"
								>
									{ t.Name }
								</textarea>
							</div>
						</div>
						@partials.SelectTaskAgentType(t)
						<div id="select-task-type">
							@partials.SelectTaskType(t, t.AgentType.String())
						</div>
						<div id="select-task-subtype">
							switch t.Type {
								case task.TypeWingetInstall, task.TypeWingetDelete:
									@partials.SelectWinGetPackageTaskSubtype(t)
								case task.TypeAddRegistryKey, task.TypeAddRegistryKeyValue, task.TypeUpdateRegistryKeyDefaultValue, task.TypeRemoveRegistryKey, task.TypeRemoveRegistryKeyValue:
									@partials.SelectRegistryTaskSubtype(t)
								case task.TypeAddLocalUser, task.TypeRemoveLocalUser:
									@partials.SelectLocalUserTaskSubtype(t)
								case task.TypeAddLocalGroup, task.TypeRemoveLocalGroup, task.TypeAddUsersToLocalGroup, task.TypeRemoveUsersFromLocalGroup:
									@partials.SelectWindowsLocalGroupTaskSubtype(t)
								case task.TypeAddUnixLocalGroup, task.TypeRemoveUnixLocalGroup:
									@partials.SelectUnixLocalGroupTaskSubtype(t)
								case task.TypeAddUnixLocalUser, task.TypeRemoveUnixLocalUser:
									@partials.SelectUnixLocalUserTaskSubtype(t)
								case task.TypeMsiInstall, task.TypeMsiUninstall:
									@partials.SelectMSITaskSubtype(t)
								case task.TypeFlatpakInstall, task.TypeFlatpakUninstall:
									@partials.SelectFlatpakPackageTaskSubtype(t)
								case task.TypeBrewFormulaInstall, task.TypeBrewFormulaUninstall, task.TypeBrewFormulaUpgrade:
									@partials.SelectHomeBrewFormulaTaskSubtype(t)
								case task.TypeBrewCaskInstall, task.TypeBrewCaskUninstall, task.TypeBrewCaskUpgrade:
									@partials.SelectHomeBrewCaskTaskSubtype(t)
								case task.TypeNetbirdInstall, task.TypeNetbirdUninstall, task.TypeNetbirdRegister:
									@partials.SelectNetbirdTaskSubtype(t)
									// Future APT subtype
									// case task.TypeAptInstall, task.TypeAptRemove, task.TypeAptUpdate, task.TypeAptUpdateAll, task.TypeAptUpgradeOs:
									// 	@partials.SelectAPTTaskSubtype(t)
							}
						</div>
						if t != nil {
							<input type="hidden" name="selected-task-type" value={ t.Type.String() }/>
						}
					</div>
					if partials.IsWinGetPackageTask(t) {
						<div class="w-full" id="package-partial">
							@partials.WingetPackageSearch(t)
						</div>
					}
					if partials.IsRegistryTask(t) {
						<div class="w-full" id="registry-partial">
							@partials.RegistryComponent(t)
						</div>
					}
					if t.Type==task.TypeAddLocalUser || t.Type==task.TypeAddUnixLocalUser {
						@TaskSecretChoice("task-password-action", i18n.T(ctx, "task_editing.password"), review.PasswordSet)
					}
					if t.Type==task.TypeAddUnixLocalUser {
						@TaskSecretChoice("task-passphrase-action", i18n.T(ctx, "task_editing.passphrase"), review.PassphraseSet)
					}
					if partials.IsLocalUserTask(t) {
						<div class="w-full" id="local-user-partial">
							@partials.LocalUserComponent(t)
						</div>
					}
					if partials.IsUnixLocalUserTask(t) {
						<div class="w-full" id="local-user-partial">
							@partials.UnixLocalUserComponent(t)
						</div>
					}
					if partials.IsWindowsLocalGroupTask(t) {
						<div class="w-full" id="local-group-partial">
							@partials.WindowsLocalGroupComponent(t)
						</div>
					}
					if partials.IsUnixLocalGroupTask(t) {
						<div class="w-full" id="local-group-partial">
							@partials.UnixLocalGroupComponent(t)
						</div>
					}
					if partials.IsMSITask(t) {
						<div class="w-full" id="msi-partial">
							@partials.MSIComponent(t)
						</div>
					}
					if partials.IsPowerShellTask(t) {
						<div class="w-full" id="powershell-partial">
							@partials.PowerShellComponent(t)
						</div>
					}
					if partials.IsUnixScriptTask(t) {
						<div class="w-full" id="unix-script-partial">
							@partials.UnixScriptComponent(t)
						</div>
					}
					if partials.IsFlatpakTask(t) {
						<div class="w-full" id="flatpak-partial">
							@partials.FlatpakPackageManagement(t)
						</div>
					}
					if partials.IsHomeBrewFormulaTask(t) || partials.IsHomeBrewCaskTask(t) {
						<div class="w-full" id="brew-partial">
							@partials.HomeBrewPackageManagement(t)
						</div>
					}
					if t.Type==task.TypeNetbirdRegister {
						@partials.NetbirdTaskComponent(t, groups)
					}
					<div class="flex flex-wrap gap-4 my-4">
						<button id="task-edit-submit" type="submit" class="uk-button uk-button-primary">
							{ i18n.T(ctx, "tasks.edit.save") }
						</button>
						<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/profiles/%d", profileID))) } hx-get={ partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/profiles/%d", profileID)) } hx-params="none" hx-target="#main" hx-swap="outerHTML" hx-push-url="true">{ i18n.T(ctx,"Cancel") }</a>
					</div>
				</fieldset>
			</form>
		</div>
	</div>
}

templ TaskSecretChoice(id, label string, present bool) {
	<div class="flex flex-col gap-2">
		<label for={ id } class="uk-form-label">{ label }</label>
		<p>{ i18n.T(ctx,"task_editing.secret_hidden") }</p>
		if present {
			<p>{ i18n.T(ctx,"task_editing.secret_present") }</p>
		} else {
			<p>{ i18n.T(ctx,"task_editing.secret_absent") }</p>
		}
		<select id={ id } name={ id } class="uk-select" required>
			<option value="keep" selected>{ i18n.T(ctx,"task_editing.keep") }</option>
			<option value="replace">{ i18n.T(ctx,"task_editing.replace") }</option>
			<option value="clear">{ i18n.T(ctx,"task_editing.clear") }</option>
		</select>
	</div>
}
