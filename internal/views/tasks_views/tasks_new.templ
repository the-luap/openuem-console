package tasks_views

import (
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/views/layout"
	"github.com/open-uem/openuem-console/internal/views/partials"
)

templ NewTask(c echo.Context, review *inventory.TaskCreationReview, commonInfo *partials.CommonInfo) {
	@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "Tasks"), Url: ""}}, commonInfo)
	<main hx-history="false" class="grid min-w-0 flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
		<div id="error" class="hidden"></div>
		@TaskCreationForm(review, commonInfo)
	</main>
}

templ TaskCreationForm(review *inventory.TaskCreationReview, commonInfo *partials.CommonInfo) {
	<div class="uk-card uk-card-default min-w-0">
		<div class="uk-card-header">
			<div class="flex justify-between items-center">
				<div class="flex flex-col my-4 mx-1">
					<h3 class="uk-card-title">{ i18n.T(ctx, "tasks.new.title") }</h3>
					<p class="mt-2 break-all">{ review.ProfileName }</p>
					<p class="mt-2">{ i18n.T(ctx,"task_creation.profile",review.ProfileID) }</p>
					if review.NameTruncated {
						<p class="mt-2">{ i18n.T(ctx,"task_creation.truncated") }</p>
					}
					<p class="uk-margin-small-top uk-text-small">
						{ i18n.T(ctx, "task_creation.description") }
					</p>
				</div>
			</div>
		</div>
		<div class="uk-card-body">
			<form
				id="task-create-form"
				class="flex flex-col gap-4 my-6"
				hx-disabled-elt="#task-create-controls"
				hx-disinherit="hx-include"
				hx-post={ string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/tasks/%d/new", review.ProfileID)))) }
				hx-target="this"
				hx-swap="none"
				hx-push-url="false"
			>
				<fieldset id="task-create-controls" class="min-w-0">
					<div class="flex flex-col gap-4 w-full">
						@partials.SelectTaskAgentType(nil)
						<div id="select-task-type"></div>
						<div id="select-task-subtype"></div>
					</div>
					<div class="w-full">
						<label class="uk-form-label" for="task-description">
							{ i18n.T(ctx, "tasks.new.name") }
						</label>
						<div class="uk-form-controls">
							<textarea
								id="task-description"
								name="task-description"
								class="uk-textarea"
								required
								maxlength="2048"
								rows="2"
								placeholder={ i18n.T(ctx, "tasks.new.text") }
								aria-label="Task description"
								autocomplete="off"
								autocorrect="off"
								autocapitalize="off"
								spellcheck="false"
							></textarea>
						</div>
					</div>
					<div id="task-definition" class="gap-4 w-full"></div>
					<div class="flex flex-wrap gap-4 my-4">
						<button id="task-create-submit" type="submit" class="uk-button uk-button-primary">
							{ i18n.T(ctx, "tasks.new.create") }
						</button>
						<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/profiles/%d", review.ProfileID))) } hx-get={ partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/profiles/%d", review.ProfileID)) } hx-params="none" hx-target="#main" hx-swap="outerHTML" hx-push-url="true">{ i18n.T(ctx,"Cancel") }</a>
					</div>
				</fieldset>
			</form>
		</div>
	</div>
}

templ TasksIndex(title string, cmp templ.Component, commonInfo *partials.CommonInfo) {
	@layout.Base("tasks", commonInfo) {
		@cmp
	}
}
