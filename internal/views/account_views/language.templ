package account_views

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/open-uem/openuem-console/internal/preferences"
	"github.com/open-uem/openuem-console/internal/views/partials"
)

templ LanguagePreference(info *partials.CommonInfo, language LanguageData) {
	<section class="uk-card uk-card-default min-w-0" aria-labelledby="account-language-title">
		<div class="uk-card-header"><h2 class="uk-card-title" id="account-language-title">{ i18n.T(ctx,"account_language.title") }</h2></div>
		<div class="uk-card-body min-w-0">
			<p id="account-language-help">{ i18n.T(ctx,"account_language.help") }</p>
			if language.Unavailable {
				<p role="status" class="mt-2">{ i18n.T(ctx,"account_language.unavailable") }</p>
			} else {
				<form method="post" action="/myaccount/language" class="mt-4">
					<input type="hidden" name="csrf" value={ info.CSRFToken }/>
					<label for="account-language">{ i18n.T(ctx,"account_language.label") }</label>
					<select id="account-language" name="locale" class="uk-select mt-2" aria-describedby="account-language-help">
						<option value="" selected?={ language.Selected == "" }>{ i18n.T(ctx,"account_language.browser") }</option>
						for _, option := range preferences.Languages() {
							<option value={ option.Code } selected?={ language.Selected == option.Code }>{ option.Name }</option>
						}
					</select>
					<button type="submit" class="uk-button uk-button-primary mt-3">{ i18n.T(ctx,"account_language.save") }</button>
				</form>
			}
		</div>
	</section>
}
