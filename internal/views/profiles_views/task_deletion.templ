package profiles_views

import (
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/openuem-console/internal/inventory"
	"github.com/open-uem/openuem-console/internal/views/partials"
	"strconv"
)

templ TaskDeletion(c echo.Context, review *inventory.TaskDeletionReview, info *partials.CommonInfo) {
	@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "Profile Management"), Url: partials.GetNavigationUrl(info, "/profiles")}, {Title: i18n.T(ctx, "task_deletion.title")}}, info)
	<main class="p-4" hx-history="false">
		<div id="error" class="hidden"></div>
		@TaskDeletionConfirmation(review, info)
	</main>
}

templ TaskDeletionConfirmation(review *inventory.TaskDeletionReview, info *partials.CommonInfo) {
	<section class="uk-card uk-card-default p-4 max-w-full" aria-labelledby="task-deletion-title" hx-disinherit="hx-include" hx-params="none">
		<h1 id="task-deletion-title" class="text-foreground text-xl font-semibold">{ i18n.T(ctx,"task_deletion.title") }</h1>
		<p class="mt-4 break-all">{ review.Name }</p>
		<p class="mt-2">{ i18n.T(ctx,"task_deletion.id") }{ strconv.FormatInt(review.ID,10) }</p>
		<p class="mt-2">{ i18n.T(ctx,"profile_deletion.id") }{ strconv.FormatInt(review.ProfileID,10) }</p>
		if review.NameTruncated {
			<p class="mt-2">{ i18n.T(ctx,"task_deletion.truncated") }</p>
		}
		<p class="mt-4">{ i18n.T(ctx,"task_deletion.consequences") }</p>
		<p class="mt-2">{ i18n.T(ctx,"task_deletion.device_effects") }</p>
		<div class="flex flex-wrap gap-4 mt-6">
			<a class="uk-button uk-button-default" href={ templ.URL(partials.GetNavigationUrl(info, fmt.Sprintf("/profiles/%d", review.ProfileID))) } hx-get={ partials.GetNavigationUrl(info, fmt.Sprintf("/profiles/%d", review.ProfileID)) } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">{ i18n.T(ctx,"Cancel") }</a>
			<button id="delete-task" type="button" class="uk-button uk-button-danger" hx-delete={ partials.GetNavigationUrl(info, fmt.Sprintf("/tasks/%d?profile=%d", review.ID, review.ProfileID)) } hx-target="this" hx-swap="none" hx-disabled-elt="this">{ i18n.T(ctx,"task_deletion.delete") }</button>
		</div>
	</section>
}
