FROM goacme/lego:v5.4.1@sha256:ac04a7aaac0270ca2c32f1e79b157087d763e78c4473551c6e093070614536e2 AS lego
FROM ghcr.io/letsencrypt/pebble:2.10.1@sha256:ddf230642b1a584f519f32e347de1b05a6e4c1f6c35c1863b33effeab5f78199 AS pebble

FROM --platform=$BUILDPLATFORM golang:1.26.8-bookworm@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81 AS build
WORKDIR /src
ENV GOTOOLCHAIN=local
COPY go.mod go.sum ./
COPY cmd/openuem-acme ./cmd/openuem-acme
COPY internal/acmeissuer ./internal/acmeissuer
COPY internal/gateway ./internal/gateway
COPY internal/security/clientidentity ./internal/security/clientidentity
COPY internal/desktop/protocol ./internal/desktop/protocol
COPY internal/mdm/windows/protocol ./internal/mdm/windows/protocol
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -mod=readonly -trimpath -buildvcs=false -ldflags='-s -w' -o /out/openuem-acme ./cmd/openuem-acme

FROM build AS test-build
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go test -mod=readonly -trimpath -buildvcs=false -c -o /out/issuer.test ./internal/acmeissuer

FROM scratch AS runtime
COPY --from=lego /lego /lego
COPY --from=lego /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/openuem-acme /openuem-acme
COPY deploy/acme/lego.LICENSE /licenses/lego.LICENSE
USER 65532:65532
STOPSIGNAL SIGTERM
ENTRYPOINT ["/openuem-acme"]

# Pebble and the DNS fixture exist only in this isolated test target.
FROM runtime AS smoke
COPY --from=pebble /app /pebble
COPY --from=test-build /out/issuer.test /issuer.test
ENV OPENUEM_ACME_TEST_BINARY=/openuem-acme
ENTRYPOINT ["/issuer.test"]
CMD ["-test.v", "-test.run=^TestACMEContainerDNS01$", "-test.timeout=90s"]

FROM runtime AS final
